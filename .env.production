# Frontend Production Environment Configuration
VITE_API_URL=https://your-farmops-backend.onrender.com/api
VITE_APP_NAME=FarmOps
VITE_APP_VERSION=2.0.0

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_OFFLINE_MODE=true

# Performance Settings
VITE_API_TIMEOUT=30000
VITE_RETRY_ATTEMPTS=3
VITE_CACHE_DURATION=300000

# Monitoring
VITE_ENABLE_ERROR_REPORTING=true
VITE_SENTRY_DSN=your-sentry-dsn-here

# Map Configuration (if needed)
VITE_MAP_API_KEY=your-map-api-key

# File Upload Settings
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf
