generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int                    @id @default(autoincrement())
  name                  String
  email                 String                 @unique
  password              String
  role                  UserRole               @default(WORKER)
  organizationId        Int?                   @map("organization_id")
  createdBy             Int?                   @map("created_by")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  lastPasswordChange     DateTime?              @map("last_password_change")
  passwordChangedBy      Int?                   @map("password_changed_by")
  passwordChangeCount   Int                    @default(0) @map("password_change_count")
  requiresPasswordChange Boolean                @default(false) @map("requires_password_change")
  address               String?
  phone                 String?
  profileImageUrl       String?                @map("profile_image_url")
  expenseEntries        ExpenseEntry[]
  incomeEntries         IncomeEntry[]
  inventoryTransactions InventoryTransaction[]
  paidInvoices          Invoice[]              @relation("InvoicePaidBy")
  invoices              Invoice[]
  subscriptions         Subscription[]
  passwordHistory       PasswordHistory[]
  organization          Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("users")
}

model Organization {
  id                  Int                 @id @default(autoincrement())
  name                String
  description         String?
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  assets              Asset[]
  expenseEntries      ExpenseEntry[]
  incomeEntries       IncomeEntry[]
  inventoryCategories InventoryCategory[]
  inventoryItems      InventoryItem[]
  subscriptions       Subscription[]
  users               User[]
  vatRecords          VatRecord[]

  @@map("organizations")
}

model IncomeEntry {
  id             Int           @id @default(autoincrement())
  amount         Decimal       @db.Decimal(10, 2)
  category       String
  paymentMethod  PaymentMethod @map("payment_method")
  date           DateTime
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  userId         Int           @map("user_id")
  organizationId Int           @map("organization_id")
  description    String?       @map("description")
  enableVAT      Boolean?      @default(false) @map("enable_vat")
  quantity       Decimal?      @db.Decimal(10, 2)
  subtotal       Decimal?      @db.Decimal(10, 2)
  unitPrice      Decimal?      @map("unit_price") @db.Decimal(10, 2)
  vatAmount      Decimal?      @map("vat_amount") @db.Decimal(10, 2)
  vatRate        Decimal?      @default(7.5) @map("vat_rate") @db.Decimal(5, 2)
  createdBy      Int?          @map("created_by")
  metadata       Json?         @map("metadata")
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([description])
  @@map("income_entries")
}

model ExpenseEntry {
  id              Int          @id @default(autoincrement())
  amount          Decimal      @db.Decimal(10, 2)
  category        String
  note            String?
  date            DateTime
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  userId          Int          @map("user_id")
  organizationId  Int          @map("organization_id")
  createdBy       Int?         @map("created_by")
  merchant        String?      @default("Manual Entry")
  hasReceipt      Boolean      @default(false)
  receiptImageUrl String?      @map("receipt_image_url")
  ocrConfidence   Int?
  ocrSource       String?
  rawText         String?
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("expense_entries")
}

model InventoryItem {
  id              Int                    @id @default(autoincrement())
  name            String
  type            InventoryType
  unit            String
  quantity        Decimal                @default(0) @db.Decimal(10, 2)
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  initialQuantity Decimal?               @map("initial_quantity") @db.Decimal(10, 2)
  description     String?
  categoryId      Int?                   @map("category_id")
  organizationId  Int?                   @map("organization_id")
  location        String?
  supplier        String?
  purchaseDate    DateTime?              @map("purchase_date")
  expiryDate      DateTime?              @map("expiry_date")
  minimumStock    Decimal?               @map("minimum_stock") @db.Decimal(10, 2)
  pricePerUnit    Decimal?               @map("price_per_unit") @db.Decimal(10, 2)
  metadata        Json?                  @map("metadata")
  category        InventoryCategory?     @relation(fields: [categoryId], references: [id])
  organization    Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions    InventoryTransaction[]

  @@map("inventory_items")
}

model InventoryCategory {
  id             Int                 @id @default(autoincrement())
  name           String
  description    String?
  icon           String?
  color          String?
  parentId       Int?                @map("parent_id")
  isSubcategory  Boolean             @default(false) @map("is_subcategory")
  organizationId Int?                @map("organization_id")
  metadata       Json?               @map("metadata")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  organization   Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         InventoryCategory?  @relation("CategorySubcategories", fields: [parentId], references: [id])
  subcategories  InventoryCategory[] @relation("CategorySubcategories")
  items          InventoryItem[]

  @@map("inventory_categories")
}

model InventoryTransaction {
  id              Int           @id @default(autoincrement())
  quantityChange  Decimal       @map("quantity_change") @db.Decimal(10, 2)
  reason          String
  usageType       UsageType?    @map("usage_type")
  costPerUnit     Decimal?      @map("cost_per_unit") @db.Decimal(10, 2)
  totalCost       Decimal?      @map("total_cost") @db.Decimal(10, 2)
  relatedEntity   String?       @map("related_entity")
  relatedEntityId Int?          @map("related_entity_id")
  date            DateTime
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  inventoryItemId Int           @map("inventory_item_id")
  userId          Int           @map("user_id")
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("inventory_transactions")
}

model Invoice {
  id              Int            @id @default(autoincrement())
  invoiceNumber   String         @unique @map("invoice_number")
  clientName      String         @map("client_name")
  clientEmail     String?        @map("client_email")
  clientPhone     String?        @map("client_phone")
  clientAddress   String?        @map("client_address")
  businessName    String         @map("business_name")
  businessEmail   String?        @map("business_email")
  businessPhone   String?        @map("business_phone")
  businessAddress String?        @map("business_address")
  items           Json
  subtotal        Decimal        @db.Decimal(10, 2)
  tax             Decimal        @default(0) @db.Decimal(10, 2)
  total           Decimal        @db.Decimal(10, 2)
  status          InvoiceStatus  @default(PENDING)
  paymentMethod   PaymentMethod? @map("payment_method")
  dueDate         DateTime?      @map("due_date")
  paidDate        DateTime?      @map("paid_date")
  paidBy          Int?           @map("paid_by")
  notes           String?
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  userId          Int            @map("user_id")
  createdBy       Int?           @map("created_by")
  paidByUser      User?          @relation("InvoicePaidBy", fields: [paidBy], references: [id])
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model Asset {
  id                  Int          @id @default(autoincrement())
  name                String
  description         String?
  category            String
  subcategory         String?
  purchaseDate        DateTime?    @map("purchase_date")
  supplier            String?
  cost                Decimal      @default(0) @db.Decimal(10, 2)
  warrantyPeriod      String?      @map("warranty_period")
  expectedLifespan    Int          @default(10) @map("expected_lifespan")
  depreciationMethod  String       @default("straight_line") @map("depreciation_method")
  currentCondition    String       @default("good")
  location            String
  assignedWorker      String?      @map("assigned_worker")
  status              String       @default("planned")
  model               String?
  serialNumber        String?      @map("serial_number")
  powerRating         String?      @map("power_rating")
  capacity            String?
  fuelType            String?      @map("fuel_type")
  maintenanceInterval String?      @map("maintenance_interval")
  organizationId      Int          @map("organization_id")
  createdBy           Int          @map("created_by")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("assets")
}

model Subscription {
  id                Int          @id @default(autoincrement())
  userId            Int          @map("user_id")
  organizationId    Int          @map("organization_id")
  plan              String
  status            String
  billingCycle      String
  price             Decimal      @db.Decimal(10, 2)
  paystackReference String?      @map("paystack_reference")
  expiresAt         DateTime?    @map("expires_at")
  activatedAt       DateTime?    @map("activated_at")
  cancelledAt       DateTime?    @map("cancelled_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model VatRecord {
  id               Int          @id @default(autoincrement())
  period           String
  date             DateTime     @default(now()) @map("date")
  vatAmount        Decimal      @db.Decimal(10, 2)
  transactionCount Int          @default(0)
  status           VatStatus    @default(PENDING) @map("status")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  userId           Int          @map("user_id")
  organizationId   Int          @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("vat_records")
}

enum UsageType {
  INITIAL_STOCK
  RESTOCK
  FEEDING
  PLANTING
  SALES
  WASTE
  TRANSFER
  ADJUSTMENT
  OTHER
}

enum UserRole {
  OWNER
  MANAGER
  WORKER
  SUPERUSER
}

enum PaymentMethod {
  CASH
  TRANSFER
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum InventoryType {
  LIVESTOCK
  PRODUCE
  CONSUMABLES
  SEEDS
  FERTILIZERS
  PESTICIDES
  EQUIPMENT
  SUPPLIES
  MEDICINE
  FEED
  OTHER
}

enum VatStatus {
  PENDING
  REMITTED
  OVERDUE
}

model PasswordHistory {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  hashedPassword String @map("hashed_password")
  changedAt   DateTime @default(now()) @map("changed_at")
  changedBy   Int?     @map("changed_by")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_history")
}
