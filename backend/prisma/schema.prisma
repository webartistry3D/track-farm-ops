generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int                    @id @default(autoincrement())
  name                  String
  email                 String                 @unique
  password              String
  role                  UserRole               @default(WORKER)
  organizationId        Int?                   @map("organization_id")
  createdBy             Int?                   @map("created_by")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  lastPasswordChange     DateTime?              @map("last_password_change")
  passwordChangedBy      Int?                   @map("password_changed_by")
  passwordChangeCount   Int                    @default(0) @map("password_change_count")
  requiresPasswordChange Boolean                @default(false) @map("requires_password_change")
  address               String?
  phone                 String?
  profileImageUrl       String?                @map("profile_image_url")
  passwordResetToken    String?                @map("password_reset_token")
  passwordResetExpiry   DateTime?              @map("password_reset_expiry")
  emailVerified         Boolean                @default(false) @map("email_verified")
  emailVerificationToken String?               @map("email_verification_token")
  expenseEntries        ExpenseEntry[]
  incomeEntries         IncomeEntry[]
  inventoryTransactions InventoryTransaction[]
  paidInvoices          Invoice[]              @relation("InvoicePaidBy")
  invoices              Invoice[]
  subscriptions         Subscription[]
  passwordHistory       PasswordHistory[]
  cctvCameras           CctvCamera[]
  notifications        Notification[]
  organization          Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  healthRecords         HealthRecord[]

  @@map("users")
}

model Organization {
  id                  Int                 @id @default(autoincrement())
  name                String
  description         String?
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  assets              Asset[]
  expenseEntries      ExpenseEntry[]
  incomeEntries       IncomeEntry[]
  inventoryCategories InventoryCategory[]
  inventoryItems      InventoryItem[]
  subscriptions       Subscription[]
  users               User[]
  vatRecords          VatRecord[]
  cctvCameras         CctvCamera[]
  crops               Crop[]
  equipmentStatus      EquipmentStatus[]
  fieldActivities     FieldActivity[]
  soilAnalyses       SoilAnalysis[]
  irrigationSchedules IrrigationSchedule[]
  pestControl         PestControl[]
  livestock          Livestock[]

  @@map("organizations")
}

model IncomeEntry {
  id             Int           @id @default(autoincrement())
  amount         Decimal       @db.Decimal(10, 2)
  category       String
  paymentMethod  PaymentMethod @map("payment_method")
  date           DateTime
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")
  userId         Int           @map("user_id")
  organizationId Int           @map("organization_id")
  description    String?       @map("description")
  enableVAT      Boolean?      @default(false) @map("enable_vat")
  quantity       Decimal?      @db.Decimal(10, 2)
  subtotal       Decimal?      @db.Decimal(10, 2)
  unitPrice      Decimal?      @map("unit_price") @db.Decimal(10, 2)
  vatAmount      Decimal?      @map("vat_amount") @db.Decimal(10, 2)
  vatRate        Decimal?      @default(7.5) @map("vat_rate") @db.Decimal(5, 2)
  createdBy      Int?          @map("created_by")
  metadata       Json?         @map("metadata")
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([description])
  @@map("income_entries")
}

model ExpenseEntry {
  id              Int          @id @default(autoincrement())
  amount          Decimal      @db.Decimal(10, 2)
  category        String
  note            String?
  date            DateTime
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  userId          Int          @map("user_id")
  organizationId  Int          @map("organization_id")
  createdBy       Int?         @map("created_by")
  merchant        String?      @default("Manual Entry")
  hasReceipt      Boolean      @default(false)
  receiptImageUrl String?      @map("receipt_image_url")
  ocrConfidence   Int?
  ocrSource       String?
  rawText         String?
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("expense_entries")
}

model InventoryItem {
  id              Int                    @id @default(autoincrement())
  name            String
  type            InventoryType
  unit            String
  quantity        Decimal                @default(0) @db.Decimal(10, 2)
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  initialQuantity Decimal?               @map("initial_quantity") @db.Decimal(10, 2)
  description     String?
  categoryId      Int?                   @map("category_id")
  organizationId  Int?                   @map("organization_id")
  location        String?
  supplier        String?
  purchaseDate    DateTime?              @map("purchase_date")
  expiryDate      DateTime?              @map("expiry_date")
  minimumStock    Decimal?               @map("minimum_stock") @db.Decimal(10, 2)
  pricePerUnit    Decimal?               @map("price_per_unit") @db.Decimal(10, 2)
  metadata        Json?                  @map("metadata")
  category        InventoryCategory?     @relation(fields: [categoryId], references: [id])
  organization    Organization?          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions    InventoryTransaction[]

  @@map("inventory_items")
}

model InventoryCategory {
  id             Int                 @id @default(autoincrement())
  name           String
  description    String?
  icon           String?
  color          String?
  parentId       Int?                @map("parent_id")
  isSubcategory  Boolean             @default(false) @map("is_subcategory")
  organizationId Int?                @map("organization_id")
  metadata       Json?               @map("metadata")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  organization   Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         InventoryCategory?  @relation("CategorySubcategories", fields: [parentId], references: [id])
  subcategories  InventoryCategory[] @relation("CategorySubcategories")
  items          InventoryItem[]

  @@map("inventory_categories")
}

model InventoryTransaction {
  id              Int           @id @default(autoincrement())
  quantityChange  Decimal       @map("quantity_change") @db.Decimal(10, 2)
  reason          String
  usageType       UsageType?    @map("usage_type")
  costPerUnit     Decimal?      @map("cost_per_unit") @db.Decimal(10, 2)
  totalCost       Decimal?      @map("total_cost") @db.Decimal(10, 2)
  relatedEntity   String?       @map("related_entity")
  relatedEntityId Int?          @map("related_entity_id")
  date            DateTime
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  inventoryItemId Int           @map("inventory_item_id")
  userId          Int           @map("user_id")
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("inventory_transactions")
}

model Invoice {
  id              Int            @id @default(autoincrement())
  invoiceNumber   String         @unique @map("invoice_number")
  clientName      String         @map("client_name")
  clientEmail     String?        @map("client_email")
  clientPhone     String?        @map("client_phone")
  clientAddress   String?        @map("client_address")
  businessName    String         @map("business_name")
  businessEmail   String?        @map("business_email")
  businessPhone   String?        @map("business_phone")
  businessAddress String?        @map("business_address")
  items           Json
  subtotal        Decimal        @db.Decimal(10, 2)
  tax             Decimal        @default(0) @db.Decimal(10, 2)
  total           Decimal        @db.Decimal(10, 2)
  status          InvoiceStatus  @default(PENDING)
  paymentMethod   PaymentMethod? @map("payment_method")
  dueDate         DateTime?      @map("due_date")
  paidDate        DateTime?      @map("paid_date")
  paidBy          Int?           @map("paid_by")
  notes           String?
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  userId          Int            @map("user_id")
  createdBy       Int?           @map("created_by")
  paidByUser      User?          @relation("InvoicePaidBy", fields: [paidBy], references: [id])
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model Asset {
  id                  Int          @id @default(autoincrement())
  name                String
  description         String?
  category            String
  subcategory         String?
  purchaseDate        DateTime?    @map("purchase_date")
  supplier            String?
  cost                Decimal      @default(0) @db.Decimal(10, 2)
  warrantyPeriod      String?      @map("warranty_period")
  expectedLifespan    Int          @default(10) @map("expected_lifespan")
  depreciationMethod  String       @default("straight_line") @map("depreciation_method")
  currentCondition    String       @default("good")
  location            String
  assignedWorker      String?      @map("assigned_worker")
  status              String       @default("planned")
  model               String?
  serialNumber        String?      @map("serial_number")
  powerRating         String?      @map("power_rating")
  capacity            String?
  fuelType            String?      @map("fuel_type")
  maintenanceInterval String?      @map("maintenance_interval")
  organizationId      Int          @map("organization_id")
  createdBy           Int          @map("created_by")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  equipmentStatus     EquipmentStatus[]

  @@map("assets")
}

model Subscription {
  id                Int          @id @default(autoincrement())
  userId            Int          @map("user_id")
  organizationId    Int          @map("organization_id")
  plan              String
  status            String
  billingCycle      String
  price             Decimal      @db.Decimal(10, 2)
  paystackReference String?      @map("paystack_reference")
  expiresAt         DateTime?    @map("expires_at")
  activatedAt       DateTime?    @map("activated_at")
  cancelledAt       DateTime?    @map("cancelled_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

model VatRecord {
  id               Int          @id @default(autoincrement())
  period           String
  date             DateTime     @default(now()) @map("date")
  vatAmount        Decimal      @db.Decimal(10, 2)
  transactionCount Int          @default(0)
  status           VatStatus    @default(PENDING) @map("status")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  userId           Int          @map("user_id")
  organizationId   Int          @map("organization_id")
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("vat_records")
}

enum UsageType {
  INITIAL_STOCK
  RESTOCK
  FEEDING
  PLANTING
  SALES
  WASTE
  TRANSFER
  ADJUSTMENT
  OTHER
}

enum UserRole {
  SUPERUSER
  OWNER
  MANAGER
  WORKER
  ACCOUNTANT
  INVENTORY
  VETERINARIAN
}

enum PaymentMethod {
  CASH
  TRANSFER
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum InventoryType {
  LIVESTOCK
  PRODUCE
  CONSUMABLES
  SEEDS
  FERTILIZERS
  PESTICIDES
  EQUIPMENT
  SUPPLIES
  MEDICINE
  FEED
  OTHER
}

enum VatStatus {
  PENDING
  REMITTED
  OVERDUE
}

model PasswordHistory {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  hashedPassword String @map("hashed_password")
  changedAt   DateTime @default(now()) @map("changed_at")
  changedBy   Int?     @map("changed_by")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_history")
}

model CctvCamera {
  id          Int      @id @default(autoincrement())
  name        String
  location    String
  ipAddress   String?  @map("ip_address")
  resolution  String?  @default("1080p")
  status      String   @default("offline") // online, offline, maintenance
  recording   Boolean  @default(false)
  lastActive  DateTime @default(now()) @map("last_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  organizationId Int?   @map("organization_id")
  createdBy   Int?     @map("created_by")
  
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator     User?          @relation(fields: [createdBy], references: [id])

  @@map("cctv_cameras")
}

// Crops Management
model Crop {
  id              Int         @id @default(autoincrement())
  name            String
  variety         String?
  plantingDate    DateTime     @map("planting_date")
  expectedHarvest DateTime     @map("expected_harvest")
  actualHarvest  DateTime?    @map("actual_harvest")
  status          CropStatus   @default(GROWING)
  zone            String
  field           String?
  area            Float?       // in hectares
  yield           Float?       // expected yield in kg
  actualYield     Float?       @map("actual_yield")
  notes           String?
  organizationId  Int          @map("organization_id")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("crops")
}

enum CropStatus {
  PLANNING
  PLANTED
  GROWING
  MATURE
  HARVESTED
  FAILED
}

// Equipment Monitoring
model EquipmentStatus {
  id              Int               @id @default(autoincrement())
  equipmentId     Int               @map("equipment_id")
  name            String
  type            String
  status          EquipmentStatusType @default(OPERATIONAL)
  lastMaintenance DateTime?          @map("last_maintenance")
  nextMaintenance DateTime?          @map("next_maintenance")
  operatingHours  Float?            @map("operating_hours")
  location        String?
  assignedWorker  String?           @map("assigned_worker")
  fuelLevel       Float?            @map("fuel_level")
  condition       String            @default("good")
  organizationId  Int               @map("organization_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  equipment       Asset?            @relation(fields: [equipmentId], references: [id])
  organization    Organization?     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("equipment_status")
}

enum EquipmentStatusType {
  OPERATIONAL
  MAINTENANCE
  REPAIR
  OUT_OF_SERVICE
}

// Field Activities
model FieldActivity {
  id              Int            @id @default(autoincrement())
  workerName      String         @map("worker_name")
  task            String
  startTime       DateTime       @map("start_time")
  endTime         DateTime?      @map("end_time")
  duration        Float?         // in hours
  progress        Float          @default(0) // percentage
  priority        Priority       @default(MEDIUM)
  status          ActivityStatus @default(IN_PROGRESS)
  zone            String?
  field           String?
  notes           String?
  organizationId  Int            @map("organization_id")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("field_activities")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ActivityStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  PAUSED
  CANCELLED
}

// Soil Analysis
model SoilAnalysis {
  id              Int      @id @default(autoincrement())
  zone            String
  field           String?
  sampleDate      DateTime @map("sample_date")
  moistureLevel    Float    @map("moisture_level")
  phLevel         Float    @map("ph_level")
  nitrogenLevel   Float    @map("nitrogen_level")
  phosphorusLevel Float    @map("phosphorus_level")
  potassiumLevel  Float    @map("potassium_level")
  organicMatter  Float    @map("organic_matter")
  texture         String?
  recommendation  String?
  treatmentType   String?  @map("treatment_type")
  treatmentDate   DateTime? @map("treatment_date")
  organizationId  Int      @map("organization_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("soil_analyses")
}

// Irrigation Scheduling
model IrrigationSchedule {
  id              Int              @id @default(autoincrement())
  zone            String
  field           String?
  startTime       DateTime         @map("start_time")
  endTime         DateTime         @map("end_time")
  duration        Float            // in minutes
  waterAmount     Float            @map("water_amount") // in liters
  frequency       String
  lastRun         DateTime?        @map("last_run")
  nextRun         DateTime?        @map("next_run")
  status          IrrigationStatus @default(SCHEDULED)
  pumpStatus      String?          @map("pump_status")
  flowRate        Float?           @map("flow_rate")
  organizationId  Int              @map("organization_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("irrigation_schedules")
}

enum IrrigationStatus {
  SCHEDULED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// Pest Control Management
model PestControl {
  id                Int      @id @default(autoincrement())
  pestType          String   @map("pest_type")
  severity          String
  affectedArea      String?  @map("affected_area")
  treatmentMethod   String   @map("treatment_method")
  applicationDate   DateTime @map("application_date")
  followUpDate      DateTime? @map("follow_up_date")
  threatLevel       String   @default("LOW")
  treatmentEfficacy Float    @default(0) @map("treatment_efficacy")
  nextSpray        DateTime? @map("next_spray")
  lastCheck         DateTime @default(now()) @map("last_check")
  chemicalsUsed     Json?    @map("chemicals_used")
  cost              Float?
  notes             String?
  organizationId    Int      @map("organization_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("pest_control")
}

// Notification System
model Notification {
  id              Int              @id @default(autoincrement())
  title           String
  message         String
  type            NotificationType @default(INFO)
  read            Boolean          @default(false)
  userId          Int              @map("user_id")
  organizationId  Int?             @map("organization_id")
  relatedEntity   String?          @map("related_entity")
  relatedEntityId Int?             @map("related_entity_id")
  metadata        Json?
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  LOW_STOCK
  INCOME_RECORDED
  EXPENSE_RECORDED
  SYSTEM_UPDATE
}

// Livestock Management
model Livestock {
  id              Int                    @id @default(autoincrement())
  name            String
  tagId           String                 @unique @map("tag_id")
  species         LivestockSpecies
  breed           String
  dateOfBirth     DateTime?              @map("date_of_birth")
  gender          LivestockGender
  weight          Decimal               @db.Decimal(10, 2)
  location        String
  healthStatus    LivestockHealthStatus  @default(HEALTHY) @map("health_status")
  lastCheckup     DateTime?              @map("last_checkup")
  notes           String?
  organizationId  Int                    @map("organization_id")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  healthRecords   HealthRecord[]
  vaccinations    Vaccination[]

  @@map("livestock")
}

enum LivestockSpecies {
  CATTLE
  SHEEP
  GOAT
  PIG
  POULTRY
  HORSE
  OTHER
}

enum LivestockGender {
  MALE
  FEMALE
}

enum LivestockHealthStatus {
  HEALTHY
  SICK
  QUARANTINE
  RECOVERY
  CRITICAL
}

// Health Records
model HealthRecord {
  id              Int                  @id @default(autoincrement())
  livestockId     Int                  @map("livestock_id")
  recordType      HealthRecordType     @map("record_type")
  date            DateTime
  veterinarian    String
  diagnosis       String?
  treatment       String?
  medications     String?
  notes           String?
  followUpDate    DateTime?            @map("follow_up_date")
  status          HealthRecordStatus   @default(SCHEDULED)
  organizationId  Int                  @map("organization_id")
  userId          Int                  @map("user_id")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  livestock       Livestock            @relation(fields: [livestockId], references: [id], onDelete: Cascade)
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("health_records")
}

enum HealthRecordType {
  CHECKUP
  VACCINATION
  TREATMENT
  SURGERY
  LAB_TEST
  OTHER
}

enum HealthRecordStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

// Vaccinations
model Vaccination {
  id                  Int          @id @default(autoincrement())
  livestockId         Int          @map("livestock_id")
  vaccineName         String       @map("vaccine_name")
  vaccineType         String?      @map("vaccine_type")
  administrationDate  DateTime     @map("administration_date")
  nextDueDate         DateTime?    @map("next_due_date")
  veterinarian        String
  batchNumber         String?      @map("batch_number")
  notes               String?
  organizationId      Int          @map("organization_id")
  createdAt           DateTime     @default(now()) @map("created_at")
  updatedAt           DateTime     @updatedAt @map("updated_at")
  livestock           Livestock    @relation(fields: [livestockId], references: [id], onDelete: Cascade)

  @@map("vaccinations")
}
