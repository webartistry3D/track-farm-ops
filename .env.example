# ─── Frontend ────────────────────────────────────────────────
VITE_API_URL=http://localhost:3001/api

# ─── Backend ─────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/farmops"

# JWT
JWT_SECRET=your_jwt_secret_here_min_32_chars

# Superuser admin key (required to create SUPERUSER accounts)
SUPERUSER_ADMIN_KEY=your_superuser_admin_key_here

# ─── Email (SMTP) ─────────────────────────────────────────────
# Example: Gmail SMTP — use an App Password, not your account password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=TrackFarmOps <your_email@gmail.com>

# ─── File Storage (AWS S3) ────────────────────────────────────
AWS_S3_BUCKET=your_bucket_name
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_ENDPOINT=
AWS_FORCE_PATH_STYLE=false

# ─── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Logging ─────────────────────────────────────────────────
LOG_FILE=logs/app.log

# ─── Payment Providers ───────────────────────────────────────
# Paystack keys (used for card/instant payments)
# Frontend key must be prefixed with VITE_ to be accessible in the browser
VITE_PAYSTACK_PUBLIC_KEY=pk_test_your_public_key_here
PAYSTACK_SECRET_KEY=sk_test_your_secret_key_here

# Manual bank transfer details (displayed to users)
BANK_NAME=Opay
BANK_ACCOUNT_NAME=WebArtistry Creations
BANK_ACCOUNT_NUMBER=1234567890

# Payment request expiry in hours (default: 48)
PAYMENT_REQUEST_EXPIRY_HOURS=48
